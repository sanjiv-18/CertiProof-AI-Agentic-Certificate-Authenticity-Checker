# CertiProof AI Backend Environment Variables

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-secrets-module
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Database
DATABASE_URL=sqlite:///./certiproof.db

# Screenshots directory
SCREENSHOTS_DIR=./screenshots

# Playwright (set to 1 to run headless)
PLAYWRIGHT_HEADLESS=1

# Optional: OpenAI for LLM planning step (not required for core flow)
# OPENAI_API_KEY=sk-...

# Rate limiting
MAX_REQUESTS_PER_MINUTE=30
